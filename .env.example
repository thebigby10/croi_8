# Copy this file to .env and fill in real values. .env is gitignored.

# Required for the LLM directive-interpretation path (app/llm.py). If unset,
# get_directives() raises immediately and main.py falls back to the
# regex/rule-based classifier in app/fallback.py.
GEMINI_API_KEY=

# Used by docker-compose.yml's mongo service. No app code talks to Mongo yet
# (no driver in requirements.txt), so this currently has no effect on
# request handling.
MONGO_URL=mongodb://mongo:27017
